# Up to 10 sites: Wichita, Vance AFB, Dodge City, Topeka, Goodland,
# Kansas City/Pleasant Hill, Hastings.
RADAR_SITES=KICT,KVNX,KDDC,KTWX,KGLD,KEAX,KUEX
# Absolute host path; create it before starting Compose and match ownership below.
RADAR_STORAGE=/srv/scratch/radar
RADAR_UID=1000
RADAR_GID=1000
IMAGE_SIZE=1536
RANGE_KM=230
# Weakest reflectivity drawn (dBZ). Hides clear-air echoes, ground clutter,
# birds and insects near the radar. Leave empty to draw everything.
MIN_REFLECTIVITY_DBZ=10
# Dual-polarization clutter filter: hide gates below both values (CC and dBZ).
# Leave MIN_CORRELATION empty to turn the filter off.
MIN_CORRELATION=0.85
CLUTTER_MAX_DBZ=35
# Unfold (dealias) velocity: true or false.
DEALIAS_VELOCITY=true
# Storm-relative velocity from Open-Meteo winds aloft (Bunkers right-mover): true or false.
STORM_RELATIVE_VELOCITY=true
# Reflectivity colors: Standard (approximate RadarScope Standard scale, -32 to 95 dBZ) or NWSRef (classic NWS, -20 to 80 dBZ).
REFLECTIVITY_PALETTE=Standard
# Numeric reflectivity volumes: the polar sweeps and a grid made from them (true or false).
VOLUME_PRODUCTS=true
# Grid spacing: horizontal in km, vertical in m (levels from this height to 15 km above sea level).
GRID_SPACING_KM=1
GRID_LEVEL_M=500
# Loopback by default. Set to the host's LAN IP if LAN clients need direct access.
RADAR_BIND_IP=127.0.0.1
RADAR_PORT=8096
